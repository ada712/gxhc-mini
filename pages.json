{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^x-(.*)": "@/components/x-$1/x-$1.vue",
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [{
