page {
  background-color: #fff;
}
.pages {
  padding-bottom: 100rpx;
}
.pages .head-icon {
  height: 44rpx;
  width: 184rpx;
}
.pages .list {
  padding-top: 30rpx;
}
.pages .list .item {
  margin: 0 30rpx;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #e5e5e5;
  padding-bottom: 26rpx;
  margin-bottom: 26rpx;
}
.pages .list .item .index {
  font-size: 24rpx;
  width: 44rpx;
  text-align: center;
}
.pages .list .item .index.bang {
  background: #ffae01;
  border-radius: 8rpx;
  color: #fff;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pages .list .item .icon {
  width: 104rpx;
  height: 104rpx;
  border: 1px solid #eee;
  border-radius: 24%;
  margin-left: 30rpx;
}
.pages .list .item .info {
  margin-left: 30rpx;
}
.pages .list .item .info .name {
  display: block;
  color: #222;
  font-size: 30rpx;
  font-weight: 500;
}
.pages .list .item .info .company {
  display: block;
  color: #888;
  font-size: 26rpx;
  margin-top: 8rpx;
}
.pages .list .item .float {
  margin-left: auto;
  color: #ff3232;
  font-size: 24rpx;
}